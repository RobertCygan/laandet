# /etc/laandet/backup-<environment>.env — read by backup.sh / restore.sh (root:root, mode 0600).
# restic repository on EU off-site storage (SEC-53), e.g. a Storage Box over SFTP:
#   sftp:uXXXXXX@uXXXXXX.your-storagebox.example.invalid:/laandet-production
RESTIC_REPOSITORY=
# The restic password lives in the owner's password manager and in this root-only file.
RESTIC_PASSWORD_FILE=/etc/laandet/restic-production.pass
# Compose project of the environment (production: laandet, staging: laandet-staging).
LAANDET_PROJECT=laandet
# Optional: URL called after a successful backup (a dead-man's-switch monitor). Leave empty if none.
BACKUP_HEARTBEAT_URL=
