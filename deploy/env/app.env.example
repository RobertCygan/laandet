# Runtime environment for `app`, `worker`, `seed` and `tools` (one file per environment).
# Server path: /opt/laandet/<environment>/secrets/app.env  (root:laandet-deploy, mode 0640)
# Names only — never commit real values (SEC-40). Generate secrets with: openssl rand -hex 32
# Values are read literally by Docker Compose, except that every "$" must be written as "$$".

# production | staging
APP_ENV=production
# Public HTTPS address (staging: https://staging.<domain>)
APP_URL=https://laandet.example.invalid

# Runtime role. Host "db" is the database service of this project. Use the password from
# pg_app_password (hex, so it needs no URL escaping).
DATABASE_URL=postgres://laandet_app:CHANGE_ME@db:5432/laandet

# At least 32 characters each; different in every environment.
BETTER_AUTH_SECRET=
IP_HASH_KEY=

MEDIA_DIR=/data/media

# EU SMTP provider (D-008), e.g. smtps://USER:PASSWORD@smtp.example.invalid:465 — required in production.
SMTP_URL=
MAIL_FROM="Laandet <noreply@laandet.example.invalid>"

# Breached-password check (k-anonymity). Default on in staging/production.
HIBP_ENABLED=

# Operator details (required in production; shown on /kontakt). MÅ FYLLES UT FØR LANSERING.
OPERATOR_LEGAL_NAME=
OPERATOR_ORGNR=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Voluntary support — leave empty until a real campaign exists (docs/SUPPORT_AND_FUNDING.md).
SUPPORT_CAMPAIGN_URL=
SUPPORT_PROVIDER_NAME=
SUPPORT_FEE_TEXT=
SUPPORT_RECIPIENT_NAME=
SUPPORT_RECIPIENT_ORGNR=

# The owner's address for worker alerts (docs/runbooks/LAUNCH.md). Empty = no alerts.
OPS_ALERT_EMAIL=

NEXT_TELEMETRY_DISABLED=1
