# Runtime environment for `app`, `worker`, `seed` and `tools` (one file per environment).
# Server path: /opt/laandet/<environment>/secrets/app.env  (root:laandet-deploy, mode 0640)
# Names only — never commit real values (SEC-40). Generate secrets with: openssl rand -hex 32
# Values are read literally by Docker Compose, except that every "$" must be written as "$$".

# production | staging
APP_ENV=production
# Public HTTPS address (staging: https://staging.<domain>)
APP_URL=https://laandet.gpsi.ai

# Runtime role. Host "db" is the database service of this project. Use the password from
# pg_app_password (hex, so it needs no URL escaping).
DATABASE_URL=postgres://laandet_app:CHANGE_ME@db:5432/laandet

# At least 32 characters each; different in every environment.
BETTER_AUTH_SECRET=
IP_HASH_KEY=

MEDIA_DIR=/data/media

# SMTP (D-008, D-060): the Hostinger mailbox kontakt@gpsi.ai (laandet.steigen@gpsi.ai is an alias of it and
# cannot log in), smtps://<mailbox, URL-encoded>:<password, URL-encoded>@smtp.hostinger.com:465.
# Required in production. deploy/bootstrap.sh asks for the password on the server and fills this in.
SMTP_URL=
MAIL_FROM="Laandet <kontakt@gpsi.ai>"

# Breached-password check (k-anonymity). Default on in staging/production.
HIBP_ENABLED=

# Operator details (required in production; shown on /kontakt), as in the terms and the privacy notice.
# GPSI GovTech Solutions is not a registered business (D-059): the operator is the person who runs
# Laandet. Until the business is registered, OPERATOR_ORGNR is "ikke registrert".
OPERATOR_LEGAL_NAME="Robert Cygan (GPSI GovTech Solutions)"
OPERATOR_ORGNR="ikke registrert"
OPERATOR_ADDRESS="Dronningensgate 14F, 8514 Narvik"
OPERATOR_EMAIL="laandet.steigen@gpsi.ai"

# Voluntary support — leave empty until a real campaign exists (docs/SUPPORT_AND_FUNDING.md).
SUPPORT_CAMPAIGN_URL=
SUPPORT_PROVIDER_NAME=
SUPPORT_FEE_TEXT=
SUPPORT_RECIPIENT_NAME=
SUPPORT_RECIPIENT_ORGNR=

# The owner's address for worker alerts (docs/runbooks/LAUNCH.md). Empty = no alerts.
OPS_ALERT_EMAIL=kontakt@gpsi.ai

NEXT_TELEMETRY_DISABLED=1
