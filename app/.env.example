# Laandet — environment variables (names and safe examples only; never commit real values)
# Copy to .env.local for development. All values are validated at startup (src/modules/config/env.ts).

# development | test | staging | production
APP_ENV=development
# Public base URL of the app (also used by Better Auth)
APP_URL=http://localhost:3000

# Runtime database role (laandet_app): least privilege
DATABASE_URL=postgres://laandet_app:CHANGE_ME@localhost:5432/laandet_dev
# Migration role (laandet_owner): used only by `npm run db:migrate` and the legal loader
DATABASE_MIGRATION_URL=postgres://laandet_owner:CHANGE_ME@localhost:5432/laandet_dev

# At least 32 random characters each (e.g. `openssl rand -base64 48`)
BETTER_AUTH_SECRET=
IP_HASH_KEY=

# Where uploaded media is stored (outside the web root)
MEDIA_DIR=./.data/media

# Email. Leave SMTP_URL empty in development/test: emails are then written to the log.
SMTP_URL=
MAIL_FROM="Laandet <noreply@example.invalid>"

# Check new passwords against known breaches (k-anonymity). Default: on in staging/production.
HIBP_ENABLED=false

# Operator details shown on Kontakt / legal pages (required when APP_ENV=production)
OPERATOR_LEGAL_NAME=
OPERATOR_ORGNR=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Voluntary support (docs/SUPPORT_AND_FUNDING.md). Leave empty until a real campaign exists.
# If SUPPORT_CAMPAIGN_URL is set, the other SUPPORT_* values are required.
SUPPORT_CAMPAIGN_URL=
SUPPORT_PROVIDER_NAME=
SUPPORT_FEE_TEXT=
SUPPORT_RECIPIENT_NAME=
SUPPORT_RECIPIENT_ORGNR=

# Operations alerts from the worker (a job failing three runs in a row, or overdue). Empty = no alerts.
OPS_ALERT_EMAIL=

# Never send Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
